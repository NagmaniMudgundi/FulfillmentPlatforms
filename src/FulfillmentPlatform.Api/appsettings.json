{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=FulfillmentPlatformDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Orders": {
    "AutoCancelAfterDays": 3
  },
  "Jwt": {
    "Issuer": "FulfillmentPlatform",
    "Audience": "FulfillmentPlatformClient",
    "ExpiryMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "RabbitMq": {
    "HostName": "localhost",
    "QueueName": "order-status-changed"
  },
  "Email": {
    "Host": "localhost",
    "Port": 1025,
    "UseStartTls": false,
    "From": "noreply@fulfillmentplatform.local"
  },
  "AllowedHosts": "*"
}
